# Public browser variable. Required for the current primary Google Sheets COD submission flow.
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=
# Public production URL of the site, used for the sitemap, robots.txt, and social previews.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only variables. Do not prefix these with NEXT_PUBLIC_.
# Supabase service_role key. Powers the admin product manager (see docs/product-manager-setup.md).
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_TRACKING_SCRIPT_URL=
GOOGLE_ADMIN_ORDERS_SCRIPT_URL=
MAISON_ADMIN_ROUTES_ENABLED=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

