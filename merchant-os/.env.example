# Merchant OS environment. Copy to .env.local for development.
# Browser-safe values (NEXT_PUBLIC_) — the anon key is safe only because every
# table is protected by Row Level Security (supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import from client code.
# Not used yet in Phase 1; reserved for trusted background jobs (imports, webhooks).
SUPABASE_SERVICE_ROLE_KEY=
