# Merchant OS environment. Copy to .env.local for development.
# Browser-safe values (NEXT_PUBLIC_) — the anon key is safe only because every
# table is protected by Row Level Security (supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Public origin of this app (e.g. https://merchant-os.vercel.app), used
# for email confirmation links. Defaults to the request's origin. Every origin
# must also be listed in Supabase → Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import from client code.
# Supabase secret key: used by webhooks, status refresh and to read each organization's
# carrier keys and store secrets on the server (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
# Sendit keys are no longer environment variables (1.6.0): each organization enters its
# own in Settings → Sendit; they are stored in provider_secrets (server-only).
